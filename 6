+<script setup lang="ts">
+import { onMounted, ref } from 'vue'
+import { useAccountStore } from '@/stores/account'
+import { useSettingStore } from '@/stores/setting'
+import BaseSwitch from '@/components/ui/BaseSwitch.vue'
+
+export interface ActivityAutomationItem { key: string, label: string }
+
+const props = withDefaults(defineProps<{
+  items: ActivityAutomationItem[]
+  title?: string
+}>(), { title: '自动化' })
+
+const accountStore = useAccountStore()
+const settingStore = useSettingStore()
+
+const loadState = ref<'loading' | 'ready' | 'error'>('loading')
+const loadError = ref('')
+const saveError = ref('')
+const savingKey = ref('')
+
+onMounted(async () => {
+  const accountId = String(accountStore.currentAccountId || '')
+  if (!accountId) {
+    loadState.value = 'error'
+    loadError.value = '请先选择账号'
+    return
+  }
+  const ok = await settingStore.fetchSettings(accountId)
+  loadState.value = ok ? 'ready' : 'error'
+  if (!ok)
+    loadError.value = '自动化设置加载失败'
+})
+
+function isEnabled(key: string): boolean {
+  return !!(settingStore.settings?.automation as any)?.[key]
+}
+
+async function toggle(item: ActivityAutomationItem) {
+  const accountId = String(accountStore.currentAccountId || '')
+  if (!accountId || savingKey.value)
+    return
+  const previous = isEnabled(item.key)
+  const next = !previous
+  ;(settingStore.settings.automation as any)[item.key] = next
+  savingKey.value = item.key
+  saveError.value = ''
+  try {
+    const result = await settingStore.saveSettings(accountId, {
+      automation: { ...(settingStore.settings.automation as any), [item.key]: next },
+    })
+    if (!result?.ok) {
+      ;(settingStore.settings.automation as any)[item.key] = previous
+      saveError.value = result?.error || '保存失败'
+    }
+  }
+  catch (error: any) {
+    ;(settingStore.settings.automation as any)[item.key] = previous
+    saveError.value = error?.message || '保存失败'
+  }
+  finally {
+    savingKey.value = ''
+  }
+}
+</script>
+
+<template>
+  <section class="rounded-2xl border border-gray-100 bg-white/80 p-4 text-sm dark:border-gray-700 dark:bg-gray-900/40">
+    <header class="flex flex-wrap items-baseline justify-between gap-2">
+      <strong class="text-gray-900 dark:text-gray-100">{{ props.title }}</strong>
+      <span class="text-xs text-gray-500 dark:text-gray-400">每 30 分钟自动检查，条件不满足或活动结束自动跳过</span>
+    </header>
+    <p v-if="loadState === 'loading'" class="mt-2 text-xs text-gray-500 dark:text-gray-400">
+      正在加载设置…
+    </p>
+    <p v-else-if="loadState === 'error'" class="mt-2 text-xs text-red-500">
+      {{ loadError }}
+    </p>
+    <template v-else>
+      <div class="mt-2 grid grid-cols-1 gap-2 sm:grid-cols-2">
+        <BaseSwitch
+          v-for="item in props.items"
+          :key="item.key"
+          :model-value="isEnabled(item.key)"
+          :label="item.label"
+          @update:model-value="toggle(item)"
+        />
+      </div>
+      <p v-if="saveError" class="mt-2 text-xs text-red-500">
+        {{ saveError }}
+      </p>
+    </template>
+  </section>
+</template>
