+export {};
+/**
+ * 活动自动化：按账号自动化开关（automation.activity_*），定时执行限时活动的领取与操作。
+ *
+ * 设计要点：
+ * - 只复用 activity-center / milk-tea 现有服务能力，不新发协议命令；
+ * - 每个开关独立尝试，"无事可做"类错误（未开启/无可领/已领取）静默跳过；
+ * - 真错误记录日志并当日重试，单开关每天最多 3 次，避免刷日志与刷请求；
+ * - 成功结果由 worker 侧转成 push_notify 推送。
+ */
+
+const { log, getSystemDateKey } = require('./utils/utils');
+
+const ACTIVITY_AUTO_CHECK_INTERVAL_MS = 30 * 60 * 1000;
+const MAX_ERROR_ATTEMPTS_PER_DAY = 3;
+
+const QUIET_ERROR_PATTERNS = [
+    '没有可领取',
+    '暂无可领取',
+    '已领取',
+    '已经领取',
+    '无需重复领取',
+    '活动尚未开放或已经结束',
+    '未发现',
+    '请先开业',
+    '已解锁',
+];
+
+function isQuietError(error: any): boolean {
+    const text = String(error?.message || error || '');
+    return QUIET_ERROR_PATTERNS.some((pattern) => text.includes(pattern));
+}
+
+interface ActivityAutoState {
+    dateKey: string;
+    errorAttempts: number;
+}
+
+const stateByKey: Record<string, ActivityAutoState> = {};
+
+function stateFor(key: string): ActivityAutoState {
+    const today = getSystemDateKey();
+    let state = stateByKey[key];
+    if (!state || state.dateKey !== today) {
+        state = { dateKey: today, errorAttempts: 0 };
+        stateByKey[key] = state;
+    }
+    return state;
+}
+
+type ActivityOutcome = { title: string; message: string } | null;
+
+async function runBattlePassClaim(): Promise<ActivityOutcome> {
+    const { claimBattlePassRewards } = require('./activity-center');
+    const result = await claimBattlePassRewards();
+    const rewards = Array.isArray(result?.rewards) ? result.rewards : [];
+    return {
+        title: '活动自动化',
+        message: `游记奖励领取成功${rewards.length ? `（${rewards.length} 项）` : ''}`,
+    };
+}
+
+async function runCharityClaim(): Promise<ActivityOutcome> {
+    const activityCenter = require('./activity-center');
+    const dto = await activityCenter.getCurrentCharityRedFlowerActivity();
+    if (!dto || !dto.active) return null;
+
+    const messages: string[] = [];
+    if (dto.seedReward?.claimable) {
+        const result = await activityCenter.claimCharityRedFlowerSeeds();
+        messages.push(result?.message || '红花种子领取成功');
+    }
+    if (dto.actions?.claimDailyGift?.available) {
+        const result = await activityCenter.claimCharityRedFlowerDailyGift();
+        messages.push(result?.message || '每日礼包领取成功');
+    }
+    const pendingRewards = (Array.isArray(dto.progressRewards) ? dto.progressRewards : [])
+        .filter((reward: any) => reward?.claimable);
+    for (const reward of pendingRewards) {
+        try {
+            const result = await activityCenter.claimCharityRedFlowerProgressReward(reward.target);
+            messages.push(result?.message || `进度奖励（累计捐赠 ${reward.target}）领取成功`);
+        } catch (error: any) {
+            if (!isQuietError(error)) throw error;
+        }
+    }
+    if (!messages.length) return null;
+    return { title: '活动自动化', message: `公益小红花：${messages.join('；')}` };
+}
+
+async function runCharityDonate(): Promise<ActivityOutcome> {
+    const activityCenter = require('./activity-center');
+    const dto = await activityCenter.getCurrentCharityRedFlowerActivity();
+    if (!dto || !dto.active) return null;
+    if (!dto.actions?.donateLove?.available) return null;
+    const result = await activityCenter.donateCharityRedFlowerLove();
+    return {
+        title: '活动自动化',
+        message: result?.message || `公益小红花：已捐赠爱心 ${dto.loveBalance}`,
+    };
+}
+
+async function runQingmeiClaim(): Promise<ActivityOutcome> {
+    const activityCenter = require('./activity-center');
+    const dto = await activityCenter.getCurrentQingMeiActivity();
+    if (!dto) return null;
+    if (!dto.actions?.claimSeed?.available) return null;
+    const result = await activityCenter.claimQingMeiDailySeed();
+    return { title: '活动自动化', message: result?.message || '青梅每日种子领取成功' };
+}
+
+async function runQingmeiBrewStep(): Promise<ActivityOutcome> {
+    const activityCenter = require('./activity-center');
+    const dto = await activityCenter.getCurrentQingMeiActivity();
+    if (!dto) return null;
+    if (dto.actions?.settle?.available) {
+        const result = await activityCenter.settleQingMeiBrew();
+        return { title: '活动自动化', message: result?.message || '青梅酿已结算出售' };
+    }
+    if (dto.actions?.continue?.available) {
+        const result = await activityCenter.continueQingMeiBrew();
+        return { title: '活动自动化', message: result?.message || '青梅酿酿造进度已推进' };
+    }
+    if (!dto.started && Array.isArray(dto.ingredients) && dto.ingredients.length > 0) {
+        const ingredients = dto.ingredients.map((item: any) => ({ uid: item.uid, count: item.count }));
+        const result = await activityCenter.startQingMeiBrew(ingredients);
+        return { title: '活动自动化', message: result?.message || '青梅酿已开始酿造' };
+    }
+    return null;
+}
+
+async function runMilkTeaFundClaim(): Promise<ActivityOutcome> {
+    const { operateMilkTeaActivity } = require('./milk-tea');
+    const result = await operateMilkTeaActivity('fundClaim');
+    const rewards = Array.isArray(result?.rewards) ? result.rewards : [];
+    return {
+        title: '活动自动化',
+        message: `奶茶成长基金奖励领取成功${rewards.length ? `（${rewards.length} 项）` : ''}`,
+    };
+}
+
+const ACTIVITY_AUTO_HANDLERS: Record<string, { label: string; run: () => Promise<ActivityOutcome> }> = {
+    activity_battle_pass_claim: { label: '游记奖励', run: runBattlePassClaim },
+    activity_charity_claim: { label: '公益小红花', run: runCharityClaim },
+    activity_charity_donate: { label: '公益捐赠', run: runCharityDonate },
+    activity_qingmei_claim: { label: '青梅种子', run: runQingmeiClaim },
+    activity_qingmei_brew: { label: '青梅酿酒', run: runQingmeiBrewStep },
+    activity_milk_tea_fund_claim: { label: '奶茶基金', run: runMilkTeaFundClaim },
+};
+
+function isActivityAutoEnabled(automation: any): boolean {
+    if (!automation || typeof automation !== 'object') return false;
+    return Object.keys(ACTIVITY_AUTO_HANDLERS).some((key) => !!automation[key]);
+}
+
+async function runActivityAutoTasks(automation: any): Promise<Array<{ title: string; message: string }>> {
+    const outcomes: Array<{ title: string; message: string }> = [];
+    if (!automation || typeof automation !== 'object') return outcomes;
+    for (const [key, handler] of Object.entries(ACTIVITY_AUTO_HANDLERS)) {
+        if (!automation[key]) continue;
+        const state = stateFor(key);
+        if (state.errorAttempts >= MAX_ERROR_ATTEMPTS_PER_DAY) continue;
+        try {
+            const outcome = await handler.run();
+            if (outcome) {
+                log('活动', outcome.message, { module: 'activity', event: handler.label, result: 'success' });
+                outcomes.push(outcome);
+            }
+        } catch (error: any) {
+            if (isQuietError(error)) continue;
+            state.errorAttempts += 1;
+            log('活动', `${handler.label}自动执行失败（今日第 ${state.errorAttempts} 次）: ${error.message}`, {
+                module: 'activity',
+                event: handler.label,
+                result: 'error',
+            });
+        }
+    }
+    return outcomes;
+}
+
+module.exports = {
+    ACTIVITY_AUTO_CHECK_INTERVAL_MS,
+    isActivityAutoEnabled,
+    runActivityAutoTasks,
+};
