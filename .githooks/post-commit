#!/bin/sh
# 版本号已在 pre-commit 阶段并入本次提交（见同目录 pre-commit）。
# 这里只做兜底检查，不再单独创建 chore(version) 提交 —— GitHub 上每次更新只保留一条记录。
# 启用方式：pnpm hooks:install  （git config core.hooksPath .githooks）

msg=$(git log -1 --pretty=%s)

# 清理 pre-commit 留下的标记（正常流程 commit-msg 已删，这里兜底）
marker="$(git rev-parse --git-path FARM_VERSION_PENDING)"
[ -f "$marker" ] && rm -f "$marker"

case "$msg" in
  "chore(version)"*) exit 0 ;;
esac

# 本次提交已带上 version.json，说明 prepare-commit-msg 正常生效
if git show --pretty=format: --name-only HEAD | grep -qx 'version.json'; then
  exit 0
fi

echo "[version] 本次提交没有带 version.json，可能是用了 --no-verify 或钩子未安装。" >&2
echo "[version] 未推送前可执行：pnpm version:bump && git commit --amend --no-edit" >&2
exit 0
