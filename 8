+function normalizeRefreshSeconds(value: unknown) {
+  const seconds = Math.floor(Number(value))
+  return Number.isSafeInteger(seconds) && seconds >= 1 && seconds <= 3600 ? seconds : 3
+}
+let preferencesLoaded = false
+function loadFarmPreferences(accountId: string) {
+  preferencesLoaded = false
+  landView.value = 'default'
+  autoRefreshEnabled.value = false
+  autoRefreshSeconds.value = 3
+  try {
+    const saved = JSON.parse(localStorage.getItem(farmPreferenceKey(accountId)) || '{}')
