+function saveFarmPreferences() {
+  const accountId = String(currentAccountId.value || '')
+  if (!preferencesLoaded || !accountId)
+    return
+  try {
+    localStorage.setItem(farmPreferenceKey(accountId), JSON.stringify({
+      autoRefresh: autoRefreshEnabled.value,
+      autoRefreshSeconds: autoRefreshSeconds.value,
+      landView: landView.value,
