+watch(currentAccountId, (accountId) => {
+  if (accountId)
+    loadFarmPreferences(String(accountId))
+}, { immediate: true })
+watch([landView, autoRefreshEnabled, autoRefreshSeconds], () => {
+  saveFarmPreferences()
