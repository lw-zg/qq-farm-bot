     activity_share_reward_share: { label: '快乐不独享·分享', run: () => runShareRewardAction('share') },
     activity_share_reward_daily: { label: '快乐不独享·每日快乐值', run: () => runShareRewardAction('daily') },
     activity_share_reward_milestones: { label: '快乐不独享·档位奖励', run: () => runShareRewardAction('milestones') },
     activity_milk_tea_cashier_claim: { label: '奶茶·门店收益', run: () => runMilkTeaAction('claim') },
     activity_milk_tea_wages_claim: { label: '奶茶·员工工资', run: () => runMilkTeaAction('wages') },
     activity_milk_tea_fund_claim: { label: '奶茶·成长基金', run: () => runMilkTeaAction('fundClaim') },
+    activity_milk_tea_upgrade: { label: '奶茶·自动升级店铺', run: () => runMilkTeaUpgrade() },
+    activity_milk_tea_hire: { label: '奶茶·自动雇佣员工', run: automation => runMilkTeaHire(automation) },
+    activity_milk_tea_craft: { label: '奶茶·自动制作奶茶', run: () => runMilkTeaCraft() },
 };
 
