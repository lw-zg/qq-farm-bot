+const MILK_TEA_HIRE_DURATION_HOURS: Record<number, number> = { 1: 4, 2: 12, 3: 24 };
+
+function milkTeaHireDurationId(automation: any): number {
+    const value = Number(automation?.activity_milk_tea_hire_duration_id);
+    return MILK_TEA_HIRE_DURATION_HOURS[value] ? value : 1;
+}
+
+async function runMilkTeaUpgrade(): Promise<ActivityOutcome> {
+    const { getMilkTeaActivity, operateMilkTeaActivity } = require('./milk-tea');
+    const state = await getMilkTeaActivity('upgrade');
+    if (!state?.active || state.settling) return null;
+    if (!state.summary?.can_upgrade) return null;
+    const expectedLevel = Number(state.summary.level);
+    await operateMilkTeaActivity('upgrade', { expectedLevel });
+    return { title: '活动自动化', message: `奶茶活动：店铺升级成功（原 Lv.${expectedLevel}）` };
+}
+
+async function runMilkTeaHire(automation: any): Promise<ActivityOutcome> {
+    const { getMilkTeaActivity, operateMilkTeaActivity } = require('./milk-tea');
+    const { getServerTimeSec, toNum } = require('../utils/utils');
+    const durationId = milkTeaHireDurationId(automation);
+    const state = await getMilkTeaActivity('hireList', { durationId });
+    if (!state?.active || state.settling) return null;
+    const hire = state.hire;
+    if (!hire) return null;
+    const now = getServerTimeSec();
+    // 距结算剩余营业时间不足该时长档要求时不雇
+    if (Number(state.settleStartTime) - now < toNum(hire.min_remain_biz_sec)) return null;
+    const candidates = [...(hire.friends || []), ...(hire.robots || [])]
+        .filter((v: any) => toNum(v?.state) === 0 && toNum(v?.rehire_available_at) <= now);
+    if (!candidates.length) return null;
+    // 与 milk-tea perform 相同的空槽判定，满槽则跳过
+    const levelConfig = require('../activity-data/milk-tea-20261015.json');
+    const level = (levelConfig.MilkTeaStoreLevelConfig || []).find((v: any) => v.level === toNum(state.shop?.level));
+    const freeSlot = Array.from({ length: level?.employee_slot_count || 0 }, (_, slot) => slot)
+        .find(slot => !(state.shop?.slots || []).some((v: any) => toNum(v.slot_index) === slot && toNum(v.end_at) > now));
+    if (freeSlot === undefined) return null;
+    const target = candidates[0];
+    const wageTotal = toNum(hire.wage_total);
+    await operateMilkTeaActivity('hire', {
+        targetGid: String(target.friend?.gid),
+        durationId,
+        expectedCosts: [{ id: 1041, count: wageTotal }],
+    });
+    const name = target.friend?.name || `GID ${target.friend?.gid}` || '员工';
+    const hours = MILK_TEA_HIRE_DURATION_HOURS[durationId] || durationId;
+    return { title: '活动自动化', message: `奶茶活动：已雇佣 ${name}（${hours} 小时班，奶茶券 ×${wageTotal}）` };
+}
+
+async function runMilkTeaCraft(): Promise<ActivityOutcome> {
+    const { getMilkTeaActivity, operateMilkTeaActivity } = require('./milk-tea');
+    const { toNum } = require('../utils/utils');
+    const state = await getMilkTeaActivity('workshop');
+    if (!state?.active || state.settling) return null;
+    const fruits = (state.fruits || []).filter((v: any) => !v.locked && toNum(v.count) > 0).slice(0, 200);
+    if (!fruits.length) return null;
+    const result = await operateMilkTeaActivity('craft', {
+        fruits: fruits.map((v: any) => ({ uid: v.uid, count: v.count })),
+    });
+    const cups = Object.values(result?.result?.crafted_cups || {}).reduce((sum: number, value: any) => sum + Number(value || 0), 0);
+    return { title: '活动自动化', message: `奶茶活动：自动制作完成（${cups} 杯）` };
+}
+
+const ACTIVITY_AUTO_HANDLERS: Record<string, { label: string; run: (automation: any) => Promise<ActivityOutcome> }> = {
