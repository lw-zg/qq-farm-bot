+function numberValue(key: string, fallback = 1): number {
+  const value = Number((settingStore.settings?.automation as any)?.[key])
+  return Number.isFinite(value) ? value : fallback
+}
+
+async function saveSelect(sel: ActivityAutomationSelect, event: Event) {
+  const accountId = String(accountStore.currentAccountId || '')
+  if (!accountId)
+    return
+  const previous = numberValue(sel.key)
+  const next = Number((event.target as HTMLSelectElement).value)
+  if (next === previous)
+    return
+  ;(settingStore.settings.automation as any)[sel.key] = next
+  saveError.value = ''
+  try {
+    const result = await settingStore.saveSettings(accountId, {
+      automation: { ...(settingStore.settings.automation as any), [sel.key]: next },
+    })
+    if (!result?.ok) {
+      ;(settingStore.settings.automation as any)[sel.key] = previous
+      saveError.value = result?.error || '保存失败'
+    }
+  }
+  catch (error: any) {
+    ;(settingStore.settings.automation as any)[sel.key] = previous
+    saveError.value = error?.message || '保存失败'
+  }
+}
